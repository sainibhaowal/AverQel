# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=1000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc curl libmagic1 poppler-utils \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system appgroup && useradd --system --gid appgroup --create-home appuser

COPY requirements.txt ./requirements.txt
# Keep the pip cache in a BuildKit cache mount. It is not written into the
# image layer, but survives between CI builds when the Buildx cache is reused.
RUN --mount=type=cache,id=averqel-pip,target=/root/.cache/pip \
    pip install \
      --cache-dir /root/.cache/pip \
      --no-compile \
      --prefer-binary \
      --timeout 120 \
      --retries 5 \
      -r requirements.txt

RUN mkdir -p /app/models && chown -R appuser:appgroup /app

USER appuser
