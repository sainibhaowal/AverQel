ARG TEST_BASE_IMAGE=backend-api-base:latest
FROM ${TEST_BASE_IMAGE}

USER root
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --no-compile --prefer-binary --timeout 120 --retries 5 \
    -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install --no-cache-dir --no-compile --prefer-binary --timeout 120 --retries 5 \
    -r /tmp/requirements-dev.txt \
    && rm /tmp/requirements-dev.txt
COPY scripts/init-test-storage.py /opt/averqel/init-test-storage.py

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTEST_ADDOPTS="-o cache_dir=/tmp/averqel-pytest-cache" \
    COVERAGE_FILE=/tmp/averqel-coverage

WORKDIR /workspace/backend
ENTRYPOINT ["pytest"]
CMD ["-q"]
