AVERQEL_ENV_FILE=.env.localprod
AVERQEL_DOMAIN=averqel.localhost
AVERQEL_PUBLIC_ORIGIN=https://averqel.localhost
AVERQEL_CADDYFILE=./ops/caddy/Caddyfile.localprod
AVERQEL_BACKEND_STATE_DIR=./.local
AVERQEL_TLS_CERTS_DIR=./.local/certs

AVERQEL_POSTGRES_USER=postgres
AVERQEL_POSTGRES_PASSWORD=replace-with-strong-password
AVERQEL_POSTGRES_DB=knowledge
AVERQEL_REDIS_PASSWORD=replace-with-strong-password
AVERQEL_MINIO_ROOT_USER=averqel_minio_root
AVERQEL_MINIO_ROOT_PASSWORD=replace-with-strong-password

AKS_ENV=staging
AKS_API_WORKERS=2
AKS_API_LIMIT_CONCURRENCY=200
AKS_API_KEEP_ALIVE_SECONDS=5
AKS_DATABASE_URL=postgresql+psycopg://postgres:replace-with-strong-password@postgres:5432/knowledge
AKS_REDIS_URL=redis://:replace-with-strong-password@redis:6379/0
AKS_MINIO_ENDPOINT=minio:9000
AKS_MINIO_ACCESS_KEY=averqel_minio_root
AKS_MINIO_SECRET_KEY=replace-with-strong-password
AKS_MINIO_SECURE=false
AKS_MINIO_VERIFY_SSL=false
AKS_MINIO_BUCKET=aks-documents

AKS_JWT_SECRET=replace-with-32-plus-char-secret
AKS_REFRESH_TOKEN_HASH_SECRET=replace-with-32-plus-char-secret
AKS_PROVIDER_SECRET_ACTIVE_KID=prod-k1
AKS_PROVIDER_SECRET_KEYRING_JSON={"prod-k1":"replace-with-base64-key"}
AKS_TOTP_SECRET_ACTIVE_KID=prod-k1
AKS_TOTP_SECRET_KEYRING_JSON={"prod-k1":"replace-with-base64-key"}
SEARXNG_SECRET=replace-with-a-random-searxng-secret

AKS_REFRESH_COOKIE_NAME=aks_refresh_token
AKS_REFRESH_COOKIE_SECURE=true
AKS_REFRESH_COOKIE_SAMESITE=strict
AKS_REFRESH_COOKIE_PATH=/api/v1/auth
AKS_CORS_ORIGINS=["https://averqel.localhost","https://localhost","https://127.0.0.1"]

AKS_LOG_LEVEL=INFO
AKS_API_PREFIX=/api/v1
AKS_JWT_ALGORITHM=HS256
AKS_JWT_ISSUER=ai-knowledge-service
AKS_JWT_AUDIENCE=ai-knowledge-service-api
AKS_JWT_ACCESS_TTL_MINUTES=15
AKS_JWT_REFRESH_TTL_DAYS=7
AKS_AUTH_MAX_FAILED_ATTEMPTS=5
AKS_AUTH_LOCKOUT_MINUTES=15

# Optional application sign-in OAuth (separate from connector/MCP OAuth).
AKS_AUTH_GOOGLE_OAUTH_CLIENT_ID=
AKS_AUTH_GOOGLE_OAUTH_CLIENT_SECRET=
AKS_AUTH_GITHUB_OAUTH_CLIENT_ID=
AKS_AUTH_GITHUB_OAUTH_CLIENT_SECRET=
AKS_AUTH_OAUTH_REDIRECT_URI=https://averqel.localhost/api/v1/auth/oauth/{provider}/callback
AKS_AUTH_OAUTH_FRONTEND_REDIRECT_URI=https://averqel.localhost/auth/login

AKS_UPLOAD_MAX_BYTES=26214400
AKS_UPLOAD_ALLOWED_MIME_TYPES=["application/pdf","text/plain","text/markdown"]
AKS_UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".txt",".md"]
AKS_INGESTION_MAX_ATTEMPTS=3
AKS_INGESTION_RETRY_BACKOFF_SECONDS=2
AKS_CHUNK_SIZE=800
AKS_CHUNK_OVERLAP=100
AKS_CHUNK_MIN_LENGTH=40

AKS_AI_INTEGRATION_SCOPE=embeddings_and_generation
AKS_EMBEDDING_DIMENSION=384
AKS_EMBEDDING_PROVIDER=sentence-transformers
AKS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AKS_EMBEDDING_BATCH_SIZE=32
AKS_EMBEDDING_NORMALIZE=true
AKS_EMBEDDING_TIMEOUT_SECONDS=8
AKS_EMBEDDING_RETRY_ATTEMPTS=3
AKS_EMBEDDING_CIRCUIT_BREAKER_THRESHOLD=3
AKS_EMBEDDING_CIRCUIT_BREAKER_RESET_SECONDS=30
AKS_RERANKING_ENABLED=true
AKS_RERANKING_PROVIDER=sentence-transformers
AKS_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
AKS_RERANKING_TIMEOUT_SECONDS=8
AKS_RERANKING_TOP_K_RETRIEVE=12
AKS_RERANKING_TOP_K_RERANK=8
AKS_RERANKING_TOP_K_ANSWER=5

AKS_LLM_PROVIDER=groq-openai-compatible
AKS_LLM_API_BASE_URL=https://api.groq.com/openai/v1
AKS_LLM_API_KEY=replace-with-provider-key
AKS_LLM_MODEL=openai/gpt-oss-20b
AKS_LLM_TEMPERATURE=0.0
AKS_PROVIDER_TIMEOUT_SECONDS=300
AKS_LLM_MAX_TOKENS_PER_REQUEST=6144
AKS_LLM_MAX_REQUESTS_PER_MINUTE=30
AKS_LLM_MONTHLY_BUDGET_USD=50
AKS_LLM_COST_PER_1M_INPUT_TOKENS_USD=0.075
AKS_LLM_COST_PER_1M_OUTPUT_TOKENS_USD=0.30

AKS_QUERY_TOP_K_MIN=1
AKS_QUERY_TOP_K_MAX=25
AKS_QUERY_CACHE_TTL_SECONDS=300
AKS_QUERY_NO_RESULT_ANSWER_TEXT=No relevant information found for the requested query.
AKS_BENCHMARK_WEEK3_QUERY_SCRIPT_PATH=scripts/benchmark_week3_queries.py
AKS_RATE_LIMIT_QUERIES_PER_USER_PER_MINUTE=60
AKS_RATE_LIMIT_GLOBAL_PER_IP_PER_5_MINUTES=300
AKS_RATE_LIMIT_UPLOAD_PER_USER_PER_5_MINUTES=20
AKS_RATE_LIMIT_AUTH_LOGIN_PER_TENANT_EMAIL_PER_5_MINUTES=30
AKS_RATE_LIMIT_AUTH_REFRESH_PER_IP_PER_5_MINUTES=60
AKS_RATE_LIMIT_AUTH_LOGOUT_PER_USER_PER_5_MINUTES=60
AKS_PROVIDER_RETRY_ATTEMPTS=3
AKS_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=3
AKS_PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=30
AKS_AUDIT_LOG_RETENTION_DAYS=90
AKS_TRANSIENT_RECORD_RETENTION_DAYS=30
AKS_CELERY_TASK_ALWAYS_EAGER=false
## Enable only after running the durable-runtime migration and validating a staged rollout.
AKS_DEEPSPACE_DURABLE_RUN_LEASE_SECONDS=90
AKS_DEEPSPACE_DURABLE_RECOVERY_INTERVAL_SECONDS=60
AKS_DEEPSPACE_DURABLE_MAX_TURNS_PER_EPOCH=96
AKS_DEEPSPACE_DURABLE_MAX_PARALLEL_NODES=4
AKS_DEEPSPACE_DURABLE_MAX_WALL_SECONDS_PER_EPOCH=1200
AKS_BOOTSTRAP_SUPER_ADMIN_EMAILS=["admin@faimatrix.com"]

AKS_CONNECTOR_OAUTH_REDIRECT_URI=
AKS_CONNECTOR_OAUTH_FRONTEND_REDIRECT_URI=
# Native remote MCP OAuth; keep separate from AKS_CONNECTOR_* credentials.
AKS_MCP_GOOGLE_OAUTH_CLIENT_ID=
AKS_MCP_GOOGLE_OAUTH_CLIENT_SECRET=
AKS_MCP_GITHUB_OAUTH_CLIENT_ID=
AKS_MCP_GITHUB_OAUTH_CLIENT_SECRET=
AKS_MCP_OAUTH_REDIRECT_URI=https://averqel.localhost/api/v1/mcp/oauth/callback
