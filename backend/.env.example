AVERQEL_ENV_FILE=.env
AKS_ENV=development
AKS_API_WORKERS=2
AKS_API_LIMIT_CONCURRENCY=100
AKS_API_KEEP_ALIVE_SECONDS=5
AKS_LOG_LEVEL=INFO
AKS_API_PREFIX=/api/v1
AVERQEL_POSTGRES_USER=postgres
AVERQEL_POSTGRES_PASSWORD=replace-with-strong-postgres-password
AVERQEL_POSTGRES_DB=knowledge
AVERQEL_REDIS_PASSWORD=replace-with-strong-redis-password
AVERQEL_MINIO_ROOT_USER=replace-with-minio-root-user
AVERQEL_MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
AVERQEL_LOCAL_POSTGRES_PORT=1005
AVERQEL_LOCAL_REDIS_PORT=1010
AVERQEL_LOCAL_MINIO_API_PORT=1015
AVERQEL_LOCAL_MINIO_CONSOLE_PORT=1020
AKS_DATABASE_URL=postgresql+psycopg://postgres:replace-with-strong-postgres-password@postgres:5432/knowledge
AKS_REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
AKS_MINIO_ENDPOINT=minio:9000
AKS_MINIO_ACCESS_KEY=replace-with-minio-root-user
AKS_MINIO_SECRET_KEY=replace-with-strong-minio-password
AKS_MINIO_SECURE=false
AKS_MINIO_BUCKET=aks-documents
AKS_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
AKS_JWT_ALGORITHM=HS256
AKS_JWT_SECRET=replace-with-strong-32-char-min-secret
AKS_JWT_ISSUER=ai-knowledge-service
AKS_JWT_AUDIENCE=ai-knowledge-service-api
AKS_JWT_ACCESS_TTL_MINUTES=15
AKS_JWT_REFRESH_TTL_DAYS=7
AKS_REFRESH_TOKEN_HASH_SECRET=replace-with-strong-32-char-min-refresh-hash-secret
AKS_REFRESH_COOKIE_NAME=aks_refresh_token
AKS_REFRESH_COOKIE_SECURE=true
AKS_REFRESH_COOKIE_SAMESITE=strict
AKS_REFRESH_COOKIE_PATH=/api/v1/auth
AKS_AUTH_MAX_FAILED_ATTEMPTS=5
AKS_AUTH_LOCKOUT_MINUTES=15

# Optional application sign-in OAuth (separate from connector/MCP OAuth).
# Register these exact callback URLs with each provider:
# https://your-domain.example.com/api/v1/auth/oauth/google/callback
# https://your-domain.example.com/api/v1/auth/oauth/github/callback
AKS_AUTH_GOOGLE_OAUTH_CLIENT_ID=
AKS_AUTH_GOOGLE_OAUTH_CLIENT_SECRET=
AKS_AUTH_GITHUB_OAUTH_CLIENT_ID=
AKS_AUTH_GITHUB_OAUTH_CLIENT_SECRET=
AKS_AUTH_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/v1/auth/oauth/{provider}/callback
AKS_AUTH_OAUTH_FRONTEND_REDIRECT_URI=https://your-domain.example.com/auth/login
AKS_PROVIDER_SECRET_ACTIVE_KID=replace-with-provider-kid
AKS_PROVIDER_SECRET_KEYRING_JSON={"replace-with-provider-kid":"replace-with-base64-aes-key"}
AKS_TOTP_SECRET_ACTIVE_KID=
AKS_TOTP_SECRET_KEYRING_JSON=

# Self-hosted DeepSpace web search. Keep this private and replace it in deployments.
SEARXNG_SECRET=replace-with-a-random-searxng-secret
AKS_UPLOAD_MAX_BYTES=26214400
AKS_UPLOAD_ALLOWED_MIME_TYPES=["application/pdf","text/plain","text/markdown"]
AKS_UPLOAD_ALLOWED_EXTENSIONS=[".pdf",".txt",".md"]
AKS_INGESTION_MAX_ATTEMPTS=3
AKS_INGESTION_RETRY_BACKOFF_SECONDS=2
AKS_CHUNK_SIZE=800
AKS_CHUNK_OVERLAP=100
AKS_CHUNK_MIN_LENGTH=40
AKS_AI_INTEGRATION_SCOPE=embeddings_only
AKS_EMBEDDING_DIMENSION=384
AKS_EMBEDDING_PROVIDER=sentence-transformers
AKS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AKS_EMBEDDING_BATCH_SIZE=32
AKS_EMBEDDING_NORMALIZE=true
AKS_EMBEDDING_TIMEOUT_SECONDS=8
AKS_EMBEDDING_RETRY_ATTEMPTS=3
AKS_EMBEDDING_CIRCUIT_BREAKER_THRESHOLD=3
AKS_EMBEDDING_CIRCUIT_BREAKER_RESET_SECONDS=30
AKS_RERANKING_ENABLED=true
AKS_RERANKING_PROVIDER=sentence-transformers
AKS_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
AKS_RERANKING_TIMEOUT_SECONDS=8
AKS_RERANKING_TOP_K_RETRIEVE=12
AKS_RERANKING_TOP_K_RERANK=8
AKS_RERANKING_TOP_K_ANSWER=5
AKS_LOCAL_MODELS_ROOT=/app/models
AKS_LOCAL_INFERENCE_BASE_URL=http://inference:1011
AKS_LOCAL_INFERENCE_TIMEOUT_SECONDS=60
AKS_LOCAL_INFERENCE_EMBEDDING_CONCURRENCY=1
AKS_LOCAL_INFERENCE_RERANK_CONCURRENCY=1
AKS_LOCAL_MODEL_WARMUP_ENABLED=true
# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------
# Supported providers (all use the OpenAI-compatible /v1/chat/completions format):
#
#   CLOUD PROVIDERS (require API key):
#     openai                - OpenAI         | https://api.openai.com/v1           | gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#     groq                  - Groq           | https://api.groq.com/openai/v1      | llama-3.3-70b-versatile, mixtral-8x7b-32768
#     groq-openai-compatible - (legacy alias for groq)
#     mistral               - Mistral AI     | https://api.mistral.ai/v1           | mistral-large-latest, mistral-small-latest
#     together              - Together AI    | https://api.together.xyz/v1         | meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#     fireworks             - Fireworks AI   | https://api.fireworks.ai/inference/v1
#     perplexity            - Perplexity     | https://api.perplexity.ai           | llama-3.1-sonar-large-128k-online
#
#   LOCAL PROVIDERS (no API key needed — runs on your machine):
#     ollama                - Ollama         | http://localhost:11434/v1           | llama3, mistral, phi3, gemma2
#     vllm                  - vLLM           | http://localhost:8000/v1            | (whatever model you loaded)
#     lmstudio              - LM Studio      | http://localhost:1234/v1            | (whatever model you loaded)
#     custom                - Any endpoint   | (set AKS_LLM_API_BASE_URL)         | (set AKS_LLM_MODEL)
#
# Quick start examples:
#
#   OpenAI:  AKS_LLM_PROVIDER=openai   AKS_LLM_API_KEY=sk-proj-...  (URL and model auto-filled)
#   Groq:    AKS_LLM_PROVIDER=groq     AKS_LLM_API_KEY=gsk_...      (URL and model auto-filled)
#   Ollama:  AKS_LLM_PROVIDER=ollama                                 (no key needed, URL auto-filled)
#   Custom:  AKS_LLM_PROVIDER=custom   AKS_LLM_API_BASE_URL=http://my-server:8080/v1  AKS_LLM_MODEL=my-model
#
# Set to "disabled" to use snippet-based answers only (no LLM generation).
# When using a cloud provider, also set AKS_AI_INTEGRATION_SCOPE=embeddings_and_generation
# ---------------------------------------------------------------------------
AKS_LLM_PROVIDER=disabled
AKS_LLM_MODEL=
AKS_LLM_API_BASE_URL=
AKS_LLM_API_KEY=
AKS_LLM_TEMPERATURE=0.1
AKS_LLM_MAX_TOKENS_PER_REQUEST=1024
AKS_LLM_MAX_REQUESTS_PER_MINUTE=30
AKS_LLM_MONTHLY_BUDGET_USD=50
AKS_LLM_COST_PER_1M_INPUT_TOKENS_USD=0.075
AKS_LLM_COST_PER_1M_OUTPUT_TOKENS_USD=0.30
AKS_QUERY_TOP_K_MIN=1
AKS_QUERY_TOP_K_MAX=25
AKS_QUERY_CACHE_TTL_SECONDS=300
AKS_QUERY_NO_RESULT_ANSWER_TEXT=No relevant information found for the requested query.
AKS_BENCHMARK_WEEK3_QUERY_SCRIPT_PATH=scripts/benchmark_week3_queries.py
AKS_RATE_LIMIT_QUERIES_PER_USER_PER_MINUTE=60
AKS_RATE_LIMIT_GLOBAL_PER_IP_PER_5_MINUTES=300
AKS_RATE_LIMIT_UPLOAD_PER_USER_PER_5_MINUTES=20
AKS_RATE_LIMIT_AUTH_LOGIN_PER_TENANT_EMAIL_PER_5_MINUTES=30
AKS_RATE_LIMIT_AUTH_REFRESH_PER_IP_PER_5_MINUTES=60
AKS_RATE_LIMIT_AUTH_LOGOUT_PER_USER_PER_5_MINUTES=60
AKS_PROVIDER_TIMEOUT_SECONDS=8
AKS_PROVIDER_RETRY_ATTEMPTS=3
AKS_PROVIDER_CIRCUIT_BREAKER_THRESHOLD=3
AKS_PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=30
AKS_AUDIT_LOG_RETENTION_DAYS=90
AKS_TRANSIENT_RECORD_RETENTION_DAYS=30
AKS_CELERY_TASK_ALWAYS_EAGER=false
AKS_DEEPSPACE_SUBAGENT_MAX_CONCURRENCY=4
AKS_DEEPSPACE_SUBAGENT_LOCK_TTL_SECONDS=7200
AKS_DEEPSPACE_SUBAGENT_RUN_TTL_SECONDS=604800
AKS_DEEPSPACE_SUBAGENT_STALE_HEARTBEAT_SECONDS=900
AKS_DEEPSPACE_SUBAGENT_TIMEOUT_SECONDS=300
AKS_DEEPSPACE_PROACTIVE_DAEMON_ENABLED=false
AKS_DEEPSPACE_PROACTIVE_DAEMON_INTERVAL_SECONDS=300
AKS_DEEPSPACE_DOCUMENT_CONTEXT_DOC_LIMIT=5
AKS_DEEPSPACE_DOCUMENT_CONTEXT_CHUNK_LIMIT=4
AKS_DEEPSPACE_DOCUMENT_CONTEXT_MAX_CHARS=6000
AKS_DEEPSPACE_DEFAULT_PLANNER_MODE=default
AKS_DEEPSPACE_DEFAULT_SUBAGENT_PROFILE=default
AKS_DEEPSPACE_RUNTIME_HOOKS_ENABLED=true
AKS_DEEPSPACE_WORKSPACE_MODE_ENABLED=true
AKS_DEEPSPACE_STRUCTURED_PLANNER_ROLLOUT_ENABLED=true
AKS_DEEPSPACE_SUBAGENT_PROFILES_ROLLOUT_ENABLED=true
AKS_DEEPSPACE_RUNTIME_HOOKS_ROLLOUT_ENABLED=true
AKS_DEEPSPACE_WORKSPACE_MODE_ROLLOUT_ENABLED=true
## Durable runtime stays off until the migration, worker queue, recovery sweep, and rollback path are verified.
AKS_DEEPSPACE_DURABLE_RUN_LEASE_SECONDS=90
AKS_DEEPSPACE_DURABLE_RECOVERY_INTERVAL_SECONDS=60
AKS_DEEPSPACE_DURABLE_MAX_TURNS_PER_EPOCH=96
AKS_DEEPSPACE_DURABLE_MAX_PARALLEL_NODES=4
# Native remote MCP OAuth uses separate credentials from connector OAuth.
AKS_MCP_GOOGLE_OAUTH_CLIENT_ID=
AKS_MCP_GOOGLE_OAUTH_CLIENT_SECRET=
AKS_MCP_GITHUB_OAUTH_CLIENT_ID=
AKS_MCP_GITHUB_OAUTH_CLIENT_SECRET=
AKS_MCP_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/v1/mcp/oauth/callback
AKS_DEEPSPACE_DURABLE_MAX_WALL_SECONDS_PER_EPOCH=1200
