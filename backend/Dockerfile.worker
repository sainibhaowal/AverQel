FROM backend-worker-base:latest
ARG GIT_VERSION=v1.0.0
ARG GIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown
ENV AKS_RELEASE_VERSION=${GIT_VERSION}
ENV AKS_GIT_SHA=${GIT_SHA}
ENV AKS_BUILD_TIMESTAMP=${BUILD_TIMESTAMP}
ENV AKS_APP_VERSION=${GIT_VERSION}
WORKDIR /app
COPY . .
CMD ["./scripts/start_worker.sh"]
