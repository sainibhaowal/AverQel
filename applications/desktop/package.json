{
  "name": "averqel-desktop",
  "private": true,
  "version": "0.1.6",
  "description": "AverQel — Agentic OS for documents, connectors, and autonomous work",
  "homepage": "https://averqel.com",
  "desktopName": "AverQel",
  "author": {
    "name": "AverQel",
    "email": "support@averqel.com",
    "url": "https://averqel.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "prepare:neosis-runtime": "node scripts/prepare-neosis-runtime.mjs",
    "build": "pnpm run prepare:neosis-runtime && electron-builder --publish never",
    "build:linux": "pnpm run prepare:neosis-runtime && electron-builder --publish never --linux deb",
    "build:windows": "pnpm run prepare:neosis-runtime && electron-builder --publish never --win nsis",
    "build:mac": "electron-builder --publish never --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.averqel.app",
    "productName": "AverQel",
    "asar": true,
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/out",
        "to": "frontend"
      },
      {
        "from": ".neosis-runtime/neosis",
        "to": "neosis",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".neosis-runtime/neosis/node_modules",
        "to": "neosis/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/neosis-local-profile.patch.yml",
        "to": "neosis/averqel-local-profile.patch.yml"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "target": [
        "deb"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "AverQel"
    },
    "publish": null
  }
}
